# Imagem de desenvolvimento (docker compose --profile app up).
# O código é montado como volume; aqui só ficam o Node e o pnpm.
FROM node:22.23.4-bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN corepack enable pnpm

WORKDIR /app
EXPOSE 3000
