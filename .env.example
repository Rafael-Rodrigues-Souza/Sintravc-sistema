# Copie para .env.local:  cp .env.example .env.local
#
# Os valores abaixo servem para o jeito padrão de desenvolver:
# serviços no Docker (docker compose up -d) e app no Windows (pnpm dev),
# tudo em localhost.
#
# Com o app em container (docker compose --profile app up), o compose troca
# sozinho os endereços (postgres, mailpit, minio). Não precisa mudar este arquivo.
#
# Homologação e produção: troque só os valores (exemplos nos comentários).
# Nenhuma linha de código muda (E32).

# --- Banco -----------------------------------------------------------------
DATABASE_URL=postgres://sintravc:sintravc@localhost:5432/sintravc
# Produção: DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/sintravc

# --- Site ------------------------------------------------------------------
# Endereço público do site, sem barra no fim. Base dos links dos e-mails (convite).
URL_SITE=http://localhost:3000
# Produção: URL_SITE=https://sintravc.org.br

# --- E-mail (SMTP) ---------------------------------------------------------
# Desenvolvimento: Mailpit. Os e-mails aparecem em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# true = TLS direto (porta 465); false = sem TLS ou STARTTLS (porta 587)
SMTP_SECURE=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE="SINTRAVC <nao-responda@sintravc.local>"
# Produção (D2), por exemplo:
# SMTP_HOST=smtp.provedor.com.br
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USUARIO=nao-responda@sintravc.org.br
# SMTP_SENHA=********
# EMAIL_REMETENTE="SINTRAVC <nao-responda@sintravc.org.br>"

# --- Armazenamento de arquivos (S3) ----------------------------------------
# Desenvolvimento: MinIO. Console em http://localhost:9001 (sintravc / sintravc-segredo)
S3_ENDPOINT=http://localhost:9000
S3_REGIAO=us-east-1
S3_BUCKET=sintravc
S3_CHAVE_ACESSO=sintravc
S3_CHAVE_SECRETA=sintravc-segredo
# true no MinIO; false no R2
S3_FORCAR_CAMINHO=true
# Endereço onde o navegador abre os arquivos
S3_URL_PUBLICA=http://localhost:9000/sintravc
# Produção com Cloudflare R2 (D3), por exemplo:
# S3_ENDPOINT=https://<ID_DA_CONTA>.r2.cloudflarestorage.com
# S3_REGIAO=auto
# S3_BUCKET=sintravc
# S3_CHAVE_ACESSO=<access key do token R2>
# S3_CHAVE_SECRETA=<secret key do token R2>
# S3_FORCAR_CAMINHO=false
# S3_URL_PUBLICA=https://arquivos.sintravc.org.br
